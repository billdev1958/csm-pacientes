# Etapa 1: Imagen ultra-ligera de Node
FROM node:22-alpine

# Establecer el directorio de trabajo
WORKDIR /app

# Copiar configuración de dependencias para Caché local en Docker
COPY package.json package-lock.json ./

# Instalar CLI de Angular y módulos locales (Clean Install)
RUN npm install -g @angular/cli
RUN npm ci

# Volúmenes virtuales (Estos archivos se montarán en vivo desde el equipo host)
COPY . .

# Exponer el puerto de Angular Development Server (4201: csm-admin-2.0 ya usa 4200)
EXPOSE 4201

# Lanzar Angular con --poll que obliga a recargar páginas sin caché aunque estés bajo virtualización WSL/Docker
CMD ["ng", "serve", "--host", "0.0.0.0", "--port", "4201", "--poll", "2000"]
